{
  "permissions": {
    "allow": [
      "Bash(.specify/extensions/git/scripts/bash/*)",
      "Edit(.specify/feature.json)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|Bash|Skill|Agent",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/dev/sdd-progress-hook.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/dev/sdd-progress-hook.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/dev/sdd-progress-hook.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
