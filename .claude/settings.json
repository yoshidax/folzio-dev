{
  "permissions": {
    "allow": [
      "Edit(/Sources/**)",
      "Edit(/Tests/**)",
      "Edit(/specs/**)",
      "Edit(/scripts/**)",
      "Edit(/docs/**)",
      "Edit(/README.md)",
      "Edit(/AGENTS.md)",
      "Edit(/Package.swift)",
      "Edit(/.claude/worktrees/**)",
      "Edit(/.specify/workflows/runs/**)",
      "Bash(swift build)",
      "Edit(/README.ja.md)",
      "Bash(swift build *)",
      "Bash(swift test)",
      "Bash(swift test *)",
      "Bash(scripts/check-no-network.sh)",
      "Bash(scripts/check-no-archive-writes.sh)",
      "Bash(scripts/make-app.sh)",
      "Bash(.specify/scripts/bash/*)",
      "Bash(git status *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git diff)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git rev-parse *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git merge *)",
      "Bash(git switch *)",
      "Bash(git branch *)",
      "Bash(git worktree *)",
      "Agent",
      "Bash(defaults read *)",
      "Bash(log show *)",
      "Bash(xcrun xctrace list *)",
      "Bash(unzip -l *)",
      "Bash(scripts/check-readme-sync.sh *)",
      "mcp__Claude_Preview__preview_screenshot",
      "mcp__claude-in-chrome__tabs_context_mcp",
      "Bash(git push -u origin claude/*)",
      "Bash(git push origin claude/*)",
      "Bash(git push -u origin ci/*)",
      "Bash(git push origin ci/*)",
      "Bash(git push -u origin chore/*)",
      "Bash(git push origin chore/*)",
      "Bash(git push -u origin docs/*)",
      "Bash(git push origin docs/*)",
      "Bash(git push -u origin feature/*)",
      "Bash(git push origin feature/*)",
      "Bash(git push -u origin bugfix/*)",
      "Bash(git push origin bugfix/*)",
      "Bash(git push -u origin agent/*)",
      "Bash(git push origin agent/*)"
    ],
    "deny": [
      "Bash(git push *master*)",
      "Bash(git push *main*)",
      "Bash(git push *--force*)",
      "Bash(git push *-f *)",
      "Bash(git push * -f)",
      "Bash(git push *--delete*)",
      "Bash(git push *+*)",
      "Bash(git push --mirror*)",
      "Bash(git push --all*)",
      "mcp__github__merge_pull_request",
      "mcp__github__push_files",
      "mcp__github__create_or_update_file",
      "mcp__github__delete_file",
      "mcp__github__update_pull_request_branch",
      "mcp__github__delete_repository",
      "mcp__github__create_repository",
      "mcp__github__fork_repository",
      "Bash(scripts/dev/merge-to-master.sh *)",
      "Bash(scripts/dev/merge-to-master.sh)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Edit(/.claude/settings.json)",
      "Edit(/.claude/settings.local.json)",
      "Edit(/scripts/dev/check-git-push.py)"
    ]
    "ask": [
        "mcp__github__actions_run_trigger",
        "Bash(gh workflow run *)",
        "Bash(gh run rerun *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"$CLAUDE_PROJECT_DIR/scripts/dev/check-git-push.py\""
          }
        ]
      }
    ]
  }
}
