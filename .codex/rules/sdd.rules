# これは OS のアクセス制御の代替ではない。push の運用は AGENTS.md を参照する。
prefix_rule(
    pattern = ["brew", "install"],
    decision = "forbidden",
    justification = "依存ツールの導入は保守者に依頼し、保守者が実行する。",
    match = ["brew install webp", "brew install --cask example"],
    not_match = ["brew list", "brew info webp"],
)
prefix_rule(
    pattern = ["brew", "reinstall"],
    decision = "forbidden",
    justification = "依存ツールの再導入は保守者に依頼し、保守者が実行する。",
    match = ["brew reinstall webp"],
)
prefix_rule(
    pattern = ["brew", "upgrade"],
    decision = "forbidden",
    justification = "依存ツールの更新は保守者に依頼し、保守者が実行する。",
    match = ["brew upgrade", "brew upgrade webp"],
)
prefix_rule(
    pattern = ["brew", "bundle"],
    decision = "forbidden",
    justification = "brew bundle は保守者に依頼し、保守者が実行する。",
    match = ["brew bundle", "brew bundle install", "brew bundle check"],
)
prefix_rule(
    pattern = ["git", "push"],
    decision = "prompt",
    justification = "フックが無効または未承認の場合にも push の確認を求める。",
    match = ["git push origin master", "git push origin chore/example"],
)
prefix_rule(
    pattern = ["git", "reset", "--hard"],
    decision = "forbidden",
    justification = "変更を破棄しない。git status と git diff で状況を確認する。",
    match = ["git reset --hard", "git reset --hard HEAD"],
)
prefix_rule(
    pattern = ["git", "clean"],
    decision = "forbidden",
    justification = "未追跡ファイルを一括削除しない。対象を個別に確認する。",
    match = ["git clean -fd"],
)
