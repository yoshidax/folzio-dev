# これは OS のアクセス制御の代替ではない。push の運用は AGENTS.md を参照する。
prefix_rule(
    pattern = ["brew", "install"],
    decision = "forbidden",
    justification = "依存ツールの導入は保守者に依頼し、保守者が実行する。",
    match = ["brew install webp", "brew install --cask example"],
    not_match = ["brew list", "brew info webp"],
)
prefix_rule(
    pattern = ["brew", "reinstall"],
    decision = "forbidden",
    justification = "依存ツールの再導入は保守者に依頼し、保守者が実行する。",
    match = ["brew reinstall webp"],
)
prefix_rule(
    pattern = ["brew", "upgrade"],
    decision = "forbidden",
    justification = "依存ツールの更新は保守者に依頼し、保守者が実行する。",
    match = ["brew upgrade", "brew upgrade webp"],
)
prefix_rule(
    pattern = ["brew", "bundle"],
    decision = "forbidden",
    justification = "brew bundle は保守者に依頼し、保守者が実行する。",
    match = ["brew bundle", "brew bundle install", "brew bundle check"],
)
prefix_rule(
    pattern = ["git", "push"],
    decision = "prompt",
    justification = "フックが無効または未承認の場合にも push の確認を求める。",
    match = ["git push origin master", "git push origin chore/example"],
)
prefix_rule(
    pattern = ["git", "reset", "--hard"],
    decision = "forbidden",
    justification = "変更を破棄しない。git status と git diff で状況を確認する。",
    match = ["git reset --hard", "git reset --hard HEAD"],
)
prefix_rule(
    pattern = ["git", "clean"],
    decision = "forbidden",
    justification = "未追跡ファイルを一括削除しない。対象を個別に確認する。",
    match = ["git clean -fd"],
)

prefix_rule(
    pattern = ["git", "switch", ["-f", "--discard-changes", "-C"]],
    decision = "forbidden",
    justification = "作業中の変更を破棄したり、ブランチを強制的に再作成したりしない。",
    match = ["git switch -f master", "git switch --discard-changes master", "git switch -C chore/example"],
)

# 依頼済みの作業で使う Git と PR の操作を許可する。
prefix_rule(
    pattern = ["git", "fetch", "origin"],
    decision = "allow",
    match = ["git fetch origin"],
    not_match = ["git fetch upstream"],
)
prefix_rule(
    pattern = ["git", ["add", "commit", "switch"]],
    decision = "allow",
    match = ["git add -- Package.swift", "git commit -F message.txt", "git switch -c chore/example"],
)
prefix_rule(
    pattern = ["gh", "pr", "create", "--draft"],
    decision = "allow",
    match = ["gh pr create --draft --head chore/example"],
    not_match = ["gh pr create --head chore/example", "gh pr create --head chore/example --draft"],
)
prefix_rule(
    pattern = ["gh", "pr", "ready"],
    decision = "allow",
    match = ["gh pr ready 93"],
)
prefix_rule(
    pattern = ["gh", "pr", ["view", "checks", "list"]],
    decision = "allow",
    match = ["gh pr view 93 --json reviews", "gh pr checks 93", "gh pr list"],
    not_match = ["gh pr create --draft", "gh pr ready 93"],
)
prefix_rule(
    pattern = ["gh", "run", ["view", "list"]],
    decision = "allow",
    match = ["gh run view 123", "gh run list --limit 1"],
    not_match = ["gh run rerun 123", "gh run cancel 123"],
)
prefix_rule(
    pattern = ["gh", "pr", "merge"],
    decision = "forbidden",
    justification = "PR のマージは保守者が行う。",
    match = ["gh pr merge 93", "gh pr merge --auto 93"],
    not_match = ["gh pr ready 93"],
)
