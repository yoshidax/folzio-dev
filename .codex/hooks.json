{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"$(git rev-parse --show-toplevel)/scripts/dev/check-git-push.py\"",
            "statusMessage": "Checking git push"
          }
        ]
      }
    ]
  }
}
