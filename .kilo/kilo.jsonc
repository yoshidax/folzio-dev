{
  "$schema": "https://app.kilo.ai/config.json",
  "permission": {
    "bash": {
      "brew install": "deny",
      "brew install *": "deny",
      "brew reinstall": "deny",
      "brew reinstall *": "deny",
      "brew upgrade": "deny",
      "brew upgrade *": "deny",
      "brew bundle": "deny",
      "brew bundle *": "deny",
      "git push *": "deny",
      "git reset --hard *": "deny",
      "git clean *": "deny"
    }
  }
}
