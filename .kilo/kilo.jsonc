{
  "$schema": "https://app.kilo.ai/config.json",
  "permission": {
    "bash": {
      "brew install": "deny",
      "brew install *": "deny",
      "brew reinstall": "deny",
      "brew reinstall *": "deny",
      "brew upgrade": "deny",
      "brew upgrade *": "deny",
      "brew bundle": "deny",
      "brew bundle *": "deny",
      "git push *": "deny",
      "scripts/dev/merge-to-master.sh *": "deny",
      "scripts/dev/merge-to-master.sh": "deny",
      "git reset --hard *": "deny",
      "git clean *": "deny",
      "gh workflow run *": "ask",
      "gh run rerun *": "ask"
    },
    "github_actions_run_trigger": "ask"
  }
}
